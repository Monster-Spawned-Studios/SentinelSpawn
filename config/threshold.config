# ================================================
# Monster Spawned Studios - SentinelSpawn threshold.config
# ================================================

# Global suppressions (example - add noisy SIDs here)
suppress gen_id 1, sig_id 1000001  # Suppress Nmap scan if too noisy

# Rate-based thresholds (applied globally or per-rule)
threshold gen_id 1, sig_id 1000020, type limit, track by_src, count 1, seconds 300   # SYN Flood: alert only once per 5 min per attacker
threshold gen_id 1, sig_id 1000010, type limit, track by_src, count 1, seconds 180   # SSH brute force

# Example: Limit C2 beacon alerts
threshold gen_id 1, sig_id 1000030, type both, track by_src, count 3, seconds 600
