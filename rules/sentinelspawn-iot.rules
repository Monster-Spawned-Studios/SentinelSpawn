# ================================================
# Monster Spawned Studios - SentinelSpawn IoT Rules
# ================================================

# Common IoT / Smart Home Device Probes
alert tcp $EXTERNAL_NET any -> $HOME_NET [554,37777,8883,8123] (msg:"SentinelSpawn IOT Suspicious Camera / MQTT / Home Assistant Access"; flow:to_server; classtype:attempted-recon; sid:1000100; rev:1;)

alert tcp $HOME_NET any -> $EXTERNAL_NET any (msg:"SentinelSpawn IOT Device Outbound to Known C2 Ports"; flow:to_server; destination_port: [4444,6666,1337,31337]; classtype:trojan-activity; sid:1000101; rev:1;)

# Mirai-style IoT Botnet Behavior
alert tcp $HOME_NET any -> $EXTERNAL_NET any (msg:"SentinelSpawn IOT Mirai-like Telnet Scan Outbound"; flow:to_server; destination_port:23; threshold:type both, track by_src, count 5, seconds 30; classtype:trojan-activity; sid:1000102; rev:1;)

# Suspicious IoT Firmware Download
alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"SentinelSpawn IOT Suspicious Firmware / Bin Download"; flow:to_server,established; http.uri; content:".bin"; nocase; http_header; content:"User-Agent|3a 20|"; pcre:"/User-Agent:.*(curl|wget|busybox)/i"; classtype:trojan-activity; sid:1000103; rev:1;)
