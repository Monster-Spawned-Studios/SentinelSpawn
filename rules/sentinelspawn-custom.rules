# ================================================
# Monster Spawned Studios - SentinelSpawn Custom Rules
# Version: 1.0 (May 2026)
# Focus: Home/OpenWRT monitoring, low noise, high signal
# ================================================

# ================================================
# 1. RECONNAISSANCE & SCANNING
# ================================================

# Port Scan Detection (various types)
alert tcp $EXTERNAL_NET any -> $HOME_NET any (msg:"SentinelSpawn SCAN Nmap TCP SYN Scan"; flow:to_server,established; flags:S,12; threshold:type both, track by_src, count 15, seconds 60; classtype:attempted-recon; sid:1000001; rev:1;)

alert udp $EXTERNAL_NET any -> $HOME_NET any (msg:"SentinelSpawn SCAN UDP Port Scan"; threshold:type both, track by_src, count 20, seconds 45; classtype:attempted-recon; sid:1000002; rev:1;)

# Aggressive Scanning
alert tcp $EXTERNAL_NET any -> $HOME_NET any (msg:"SentinelSpawn SCAN Rapid Port Sweep"; flow:to_server; threshold:type both, track by_src, count 50, seconds 30; classtype:attempted-recon; sid:1000003; rev:1;)

# ================================================
# 2. BRUTE FORCE & AUTH ATTACKS
# ================================================

alert tcp $EXTERNAL_NET any -> $HOME_NET 22 (msg:"SentinelSpawn BRUTE SSH Brute Force Attempt"; flow:to_server,established; threshold:type both, track by_src, count 8, seconds 120; classtype:attempted-recon; sid:1000010; rev:1;)

alert tcp $EXTERNAL_NET any -> $HOME_NET 23 (msg:"SentinelSpawn BRUTE Telnet Brute Force"; flow:to_server; threshold:type both, track by_src, count 6, seconds 60; classtype:attempted-recon; sid:1000011; rev:1;)

alert tcp $EXTERNAL_NET any -> $HOME_NET 80,443 (msg:"SentinelSpawn BRUTE HTTP Basic Auth Brute Force"; flow:to_server,established; http_header; content:"Authorization: Basic"; threshold:type both, track by_src, count 12, seconds 90; classtype:attempted-recon; sid:1000012; rev:1;)

# ================================================
# 3. DENIAL OF SERVICE (DoS)
# ================================================

alert tcp $EXTERNAL_NET any -> $HOME_NET any (msg:"SentinelSpawn DOS SYN Flood"; flags:S; threshold:type both, track by_src, count 150, seconds 10; classtype:denial-of-service; sid:1000020; rev:1;)

alert udp $EXTERNAL_NET any -> $HOME_NET any (msg:"SentinelSpawn DOS UDP Flood"; threshold:type both, track by_src, count 300, seconds 15; classtype:denial-of-service; sid:1000021; rev:1;)

alert icmp $EXTERNAL_NET any -> $HOME_NET any (msg:"SentinelSpawn DOS ICMP Flood"; threshold:type both, track by_src, count 200, seconds 10; classtype:denial-of-service; sid:1000022; rev:1;)

# ================================================
# 4. COMMAND & CONTROL (C2) & MALWARE
# ================================================

# Suspicious Beaconing
alert tcp $HOME_NET any -> $EXTERNAL_NET any (msg:"SentinelSpawn C2 Possible Beaconing Regular Intervals"; flow:to_server,established; threshold:type both, track by_src, count 8, seconds 300; classtype:trojan-activity; sid:1000030; rev:1;)

# Common C2 User-Agents
alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"SentinelSpawn C2 Suspicious User-Agent (Curl/PowerShell)"; flow:to_server,established; http_user_agent; content:"curl"; nocase; or content:"PowerShell"; nocase; classtype:trojan-activity; sid:1000031; rev:1;)

# DNS-based C2 / Tunneling
alert dns $HOME_NET any -> any any (msg:"SentinelSpawn C2 Suspicious Long DNS Query"; dns.query; bsize:>80; classtype:trojan-activity; sid:1000032; rev:1;)

alert dns any any -> any any (msg:"SentinelSpawn C2 High Volume DNS Queries"; threshold:type both, track by_src, count 40, seconds 60; classtype:trojan-activity; sid:1000033; rev:1;)

# ================================================
# 5. EXPLOITS & WEB ATTACKS
# ================================================

alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"SentinelSpawn EXPLOIT Common Web Shell Access"; flow:to_server,established; http.uri; content:".php"; nocase; content:"cmd="; nocase; classtype:web-application-attack; sid:1000040; rev:1;)

alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"SentinelSpawn EXPLOIT SQL Injection Attempt"; flow:to_server; http.uri; pcre:"/(\b(select|union|insert|update|delete)\b.*\bfrom\b|\bor\b\s+1=1)/i"; classtype:web-application-attack; sid:1000041; rev:1;)

# ================================================
# 6. IOT / HOME NETWORK SPECIFIC
# ================================================

alert tcp $EXTERNAL_NET any -> $HOME_NET 5555,8080,9000 (msg:"SentinelSpawn IOT Suspicious IoT Device Access"; flow:to_server; classtype:attempted-recon; sid:1000050; rev:1;)

alert udp $HOME_NET any -> $EXTERNAL_NET 53 (msg:"SentinelSpawn IOT Suspicious DNS Exfil"; threshold:type both, track by_src, count 25, seconds 30; classtype:trojan-activity; sid:1000051; rev:1;)

# ================================================
# END OF RULES
# ================================================

